{# Wert einer Dezimal-Position (z. B. 2,35 m²) – im Warenkorb änderbar, sonst nur Anzeige #}
{% set value = novaDezimal.wert ?? 0 %}
{% set unit = novaDezimal.einheit ?? '' %}
{% set offcanvas = displayMode is defined and displayMode == 'offcanvas' %}
{% set editable = displayMode is defined and (displayMode == 'default' or offcanvas)
    and config('NovaDezimal.config.cartEdit')
    and (nestingLevel is not defined or nestingLevel < 1)
    and lineItem.id is defined %}

<div class="row line-item-quantity-row nova-dezimal-line">
    <div class="line-item-quantity-label">
        {{ (novaDezimal.bezeichnung ?? '') ?: 'checkout.cartHeaderQuantity'|trans|sw_sanitize }}
    </div>
    <div class="line-item-quantity-select-wrapper">
        {% if editable %}
            {# Im Seiten-Warenkorb (Off-Canvas) übernimmt Shopwares Off-Canvas-Skript das Absenden per AJAX #}
            <form action="{{ path('frontend.nova_dezimal.line_item.update', { id: lineItem.id }) }}"
                  method="post"
                  class="nova-dezimal-line-form{% if offcanvas %} nova-dezimal-line-form-offcanvas{% endif %}">
                <input type="hidden" name="redirectTo" value="{{ offcanvas ? 'frontend.cart.offcanvas' : (app.request.attributes.get('_route')|default('frontend.checkout.cart.page')) }}">
                <div class="input-group input-group-sm">
                    <input type="text"
                           inputmode="decimal"
                           autocomplete="off"
                           name="novaDezimalWert"
                           class="form-control{% if offcanvas %} js-offcanvas-cart-change-quantity-number{% endif %}"
                           value="{{ value|number_format(2, ',', '') }}"
                           aria-label="{{ (novaDezimal.bezeichnung ?? '') ?: unit }} – {{ lineItem.label }}">
                    <span class="input-group-text">{{ unit }}</span>
                </div>
                <button type="submit" class="btn btn-sm btn-outline-primary w-100 mt-1 nova-dezimal-line-apply">
                    {{ 'novaDezimal.apply'|trans|sw_sanitize }}
                </button>
            </form>
        {% else %}
            <span class="nova-dezimal-line-value">{{ value|number_format(2, ',', '.') }} {{ unit }}</span>
        {% endif %}
        {% if novaDezimal.preisJeEinheit is defined and novaDezimal.preisJeEinheit %}
            <div class="nova-dezimal-line-unit small text-muted">
                × {{ novaDezimal.preisJeEinheit|currency }} / {{ unit }}
            </div>
        {% endif %}
        {% if novaDezimal.laufmeter is defined and novaDezimal.laufmeter %}
            <div class="nova-dezimal-line-running small">
                {{ 'novaDezimal.runningMetres'|trans({
                    '%metres%': novaDezimal.laufmeter|number_format(2, ',', '.'),
                    '%width%': novaDezimal.rollenbreite|number_format(0, ',', '.')
                })|sw_sanitize }}
            </div>
        {% endif %}
    </div>
</div>
