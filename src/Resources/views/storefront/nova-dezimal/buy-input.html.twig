{# Eingabe des Wertes (z. B. 2,35 m²) statt der Stückzahl – die Position hat immer Menge 1 #}
{% set decimals = novaDezimal.decimals %}
{# Ein gemeinsamer Rahmen um die ganze Gruppe, die Teile selbst ohne Rahmen – sonst schneidet eine
   abgerundete Gruppe (z. B. Pillenform im Theme) die Ecken der einzelnen Rahmen ab #}
<style>
    .nova-dezimal-group { flex-wrap: nowrap; align-items: stretch; border: 1px solid var(--nova-border, var(--bs-border-color, #dee2e6)); border-radius: 999px; overflow: hidden; background: var(--bs-body-bg, #fff); }
    .nova-dezimal-group:focus-within { border-color: var(--bs-primary, #0d6efd); box-shadow: 0 0 0 .2rem rgba(var(--bs-primary-rgb, 13, 110, 253), .2); }
    .nova-dezimal-group > .btn, .nova-dezimal-group > .form-control, .nova-dezimal-group > .input-group-text { border: 0; border-radius: 0; background: transparent; box-shadow: none; }
    .nova-dezimal-group > .btn { min-width: 2.25rem; padding-inline: .5rem; }
    .nova-dezimal-group > .btn:hover { background: var(--bs-tertiary-bg, #f8f9fa); }
    .nova-dezimal-group > .form-control { min-width: 3rem; padding-inline: .25rem; text-align: right; }
    .nova-dezimal-group > .nova-dezimal-unit { padding-inline: 0 .25rem; color: var(--bs-secondary-color, #6c757d); }
</style>
<fieldset class="col-4 d-flex justify-content-end nova-dezimal-input">
    <legend class="form-label visually-hidden">
        {{ (novaDezimal.label ?: 'novaDezimal.value'|trans)|striptags }} ({{ novaDezimal.unit }})
    </legend>
    <input type="hidden" name="lineItems[{{ product.id }}][quantity]" value="1">
    <div class="input-group nova-dezimal-group">
        <button type="button" class="btn btn-minus js-nova-dezimal-minus" aria-label="{{ 'component.product.quantitySelect.decrease'|trans|striptags }}">
            {% sw_icon 'minus' style {size: 'xs'} %}
        </button>
        <input type="text"
               inputmode="decimal"
               autocomplete="off"
               name="lineItems[{{ product.id }}][payload][novaDezimal][wert]"
               class="form-control js-nova-dezimal-value"
               value="{{ novaDezimal.default|number_format(decimals, ',', '') }}"
               aria-label="{{ (novaDezimal.label ?: 'novaDezimal.value'|trans)|striptags }} ({{ novaDezimal.unit }})">
        <span class="input-group-text nova-dezimal-unit">{{ novaDezimal.unit }}</span>
        <button type="button" class="btn btn-plus js-nova-dezimal-plus" aria-label="{{ 'component.product.quantitySelect.increase'|trans|striptags }}">
            {% sw_icon 'plus' style {size: 'xs'} %}
        </button>
    </div>
</fieldset>
